/* =========================
   ピン
========================= */

locations.forEach(loc => {
  viewer.entities.add({
    position: Cesium.Cartesian3.fromDegrees(loc.coords[0], loc.coords[1]),
    point: {
      pixelSize: 10,
      color: Cesium.Color.YELLOW
    }
  });
});

/* =========================
   状態管理
========================= */

let i = 0;
let playing = false;

/* =========================
   ユーティリティ
========================= */

function sleep(ms) {
  return new Promise(r => setTimeout(r, ms));
}

/* =========================
   カメラ制御（重要）
========================= */

function resetCamera() {
  viewer.camera.lookAtTransform(Cesium.Matrix4.IDENTITY);
}

/* =========================
   2段階移動（現行最適）
========================= */

function travelTo(loc) {
  return new Promise(resolve => {

    resetCamera();

    const lon = loc.coords[0];
    const lat = loc.coords[1];

    // ① 上空
    viewer.camera.flyTo({
      destination: Cesium.Cartesian3.fromDegrees(
        lon,
        lat,
        8000000
      ),
      duration: 2.2,
      easingFunction: Cesium.EasingFunction.CUBIC_IN_OUT,

      complete: () => {

        setTimeout(() => {

          // ② ピンへズーム
          viewer.camera.flyTo({
            destination: Cesium.Cartesian3.fromDegrees(
              lon,
              lat,
              500000
            ),
            duration: 2.2,
            easingFunction: Cesium.EasingFunction.CUBIC_IN_OUT,
            complete: resolve
          });

        }, 300);

      }
    });
  });
}

/* =========================
   ストーリー本体
========================= */

async function runStory() {
  if (playing) return;
  playing = true;

  while (i < locations.length) {

    const loc = locations[i];

    await travelTo(loc);

    popup.innerHTML = loc.html;
    popup.style.display = "block";

    await sleep(4000);

    i++;
  }

  resetCamera();

  setTimeout(() => {
    i = 0;
    playing = false;
    runStory();
  }, 5000);
}

/* =========================
   開始
========================= */

viewer.camera.flyTo({
  destination: Cesium.Cartesian3.fromDegrees(-15, -25, 22000000),
  duration: 4,
  complete: () => {
    setTimeout(runStory, 1500);
  }
});
